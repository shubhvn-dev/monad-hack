# ── Required ──────────────────────────────────────────────────────────────────

# Monad testnet RPC endpoint
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Contract addresses (from deployed TrackFund)
TRACK_FUND_ADDRESS=0x1bB8A87253d5E717130538b6E39c4e3a53416092
MUSD_ADDRESS=0xCCBE5a3C7dC5287C412598dfb5AEA6571710021e

# Safe multisig address (the one that is admin of TrackFund)
SAFE_ADDRESS=0x0257C2bFad2c97E8fb69f6E0106d6CE07EF2B72F

# Private key of the agent wallet — must be a Safe owner to sign proposals
AGENT_PRIVATE_KEY=0x...

# Fallback project wallet used only when proposer address is unavailable.
# Normal path: funded MUSD goes to the proposal's proposer address automatically.
# PROJECT_WALLET_DEFAULT=0x...

# ── Optional ──────────────────────────────────────────────────────────────────

# Monad testnet chain ID
SAFE_CHAIN_ID=10143

# Safe Transaction Service URL.
# Monad testnet has no official Safe TX service.
# Leave empty and set SAFE_SERVICE_ENABLED=false to write txs to ./logs/ instead.
SAFE_SERVICE_URL=

# Set true only when a Safe TX service is reachable at SAFE_SERVICE_URL.
SAFE_SERVICE_ENABLED=false

# Max requestedAmount (wei) the agent will auto-propose. Default = 1000 MUSD.
MAX_REQUESTED_AMOUNT=1000000000000000000000

# Minimum MUSD the fund must retain after funding (0 = no floor).
MIN_FUND_BALANCE=0

# How often to poll for new events (ms)
POLL_INTERVAL_MS=5000

# Directory for JSON log output
LOG_DIR=./logs
